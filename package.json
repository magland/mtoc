{
  "name": "mtoc",
  "version": "0.0.1",
  "description": "Static numbl-to-C translator",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "translate": "tsx src/cli.ts translate",
